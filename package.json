{
  "name": "rove",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev:web": "pnpm --filter @rove/web dev",
    "dev:engine": "pnpm --filter @rove/engine dev",
    "lint": "pnpm --filter @rove/web lint && pnpm --filter @rove/docs lint && pnpm exec prettier --check .",
    "format": "pnpm exec prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev:docs": "pnpm --filter @rove/docs dev",
    "deploy:setup": "node deployment/setup.mjs",
    "deploy:check": "node deployment/run.mjs check",
    "deploy:db": "node deployment/run.mjs migrate",
    "deploy:seed": "pnpm deploy:admin seed",
    "deploy:admin": "node deployment/run.mjs admin",
    "deploy:probe": "node deployment/run.mjs probe"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
