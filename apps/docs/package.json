{
  "name": "@rove/docs",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "22.x"
  },
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "start": "next start --port 3001",
    "postinstall": "fumadocs-mdx",
    "check:references": "fumadocs-mdx && node --import tsx scripts/check-references.ts",
    "typecheck": "fumadocs-mdx && next typegen && tsc --noEmit",
    "build": "pnpm check:references && next build --webpack",
    "lint": "eslint",
    "test": "node --import tsx --test scripts/*.test.ts",
    "reference:snippets": "node --import tsx scripts/reference-snippets.ts"
  },
  "dependencies": {
    "@rove/contracts": "workspace:*",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "fumadocs-core": "16.15.18",
    "fumadocs-ui": "16.15.18",
    "fumadocs-mdx": "15.4.6",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@rove/lab": "workspace:*",
    "@rove/evidence": "workspace:*",
    "@rove/ocpi": "workspace:*",
    "@rove/protection": "workspace:*",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.9.2",
    "tsx": "^4.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "@rove/domain": "workspace:*"
  }
}
