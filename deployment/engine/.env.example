# Import into Koyeb and use locally for deploy:db / deploy:admin.
NODE_ENV=production
ACCESS_MODE=hosted
ENGINE_HOST=0.0.0.0
ENGINE_PORT=4100
APP_ORIGIN=https://rove-app.vercel.app
ENGINE_ORIGIN=https://rove-engine-your-org.koyeb.app
ENGINE_SERVICE_TOKEN=
# Copy the Session pooler URL from Supabase Connect (port 5432).
# URL-encode the password; retain TLS server verification.
DATABASE_URL=
HOSTED_SESSION_HOURS=24
# Conservative initial limits for the Koyeb free instance.
HOSTED_MAX_STREAMS=8
HOSTED_STREAMS_PER_SESSION=2

# Optional: fill ALL settings below before creating live-run invites.
# Leave empty for published analysis only; this disables live admission.
TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CHAIN_ID=42431
TEMPO_ASSET_ADDRESS=0x20C0000000000000000000000000000000000000
TEMPO_ASSET_DECIMALS=6
TEMPO_SESSION_BACKEND=precompile
TEMPO_PAYER_ADDRESS=
TEMPO_PAYEE_ADDRESS=
TEMPO_PAYER_PRIVATE_KEY=
TEMPO_PAYEE_PRIVATE_KEY=
TEMPO_VOUCHER_SIGNER_ADDRESS=
TEMPO_VOUCHER_SIGNER_PRIVATE_KEY=
TEMPO_INITIAL_DEPOSIT=1000000
TEMPO_TOP_UP_AMOUNT=500000
TEMPO_FIRST_VOUCHER_AMOUNT=100000
TEMPO_SECOND_VOUCHER_AMOUNT=200000
CDR_CURRENCY=USD
CDR_SETTLEMENT_ASSET_ID=0x20C0000000000000000000000000000000000000
CDR_SOURCE_PARTY_ID=controlled-cpo
# Cumulative deployment budget, not per-run. One run reserves 10500000.
HOSTED_FUNDING_BUDGET=
HOSTED_FEE_BUDGET=
HOSTED_GAS_LIMIT=
HOSTED_MAX_FEE_PER_GAS=
HOSTED_MAX_TRANSACTIONS_PER_RUN=32
