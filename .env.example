NODE_ENV=development
ENGINE_ORIGIN=http://127.0.0.1:4100
ENGINE_HOST=127.0.0.1
ENGINE_PORT=4100
DATABASE_URL=postgres://localhost:5432/rove
DEMO_SESSION_TOKEN=

TEMPO_RPC_URL=https://rpc.moderato.tempo.xyz
TEMPO_CHAIN_ID=42431
TEMPO_ASSET_ADDRESS=0x20C0000000000000000000000000000000000000
TEMPO_ASSET_DECIMALS=6
TEMPO_SESSION_BACKEND=precompile
TEMPO_PAYER_ADDRESS=
TEMPO_PAYEE_ADDRESS=
TEMPO_PAYER_PRIVATE_KEY=
TEMPO_PAYEE_PRIVATE_KEY=
TEMPO_VOUCHER_SIGNER_ADDRESS=
TEMPO_VOUCHER_SIGNER_PRIVATE_KEY=
TEMPO_INITIAL_DEPOSIT=1000000
TEMPO_TOP_UP_AMOUNT=500000
TEMPO_FIRST_VOUCHER_AMOUNT=100000
TEMPO_SECOND_VOUCHER_AMOUNT=200000

EVIDENCE_PROFILE_ID=ocmf-secp256r1-sha256
EVIDENCE_METER_ID=17619300
EVIDENCE_SESSION_ID=29
EVIDENCE_PUBLIC_KEY_HEX=3059301306072A8648CE3D020106082A8648CE3D030107034200043AEEB45C392357820A58FDFB0857BD77ADA31585C61C430531DFA53B440AFBFDD95AC887C658EA55260F808F55CA948DF235C2108A0D6DC7D4AB1A5E1A7955BE
EVIDENCE_MAX_AGE_MS=60000

CDR_CURRENCY=USD
CDR_SETTLEMENT_ASSET_ID=0x20C0000000000000000000000000000000000000
CDR_SOURCE_PARTY_ID=controlled-cpo

# Public cross-application origins; required explicitly for builds/deployment.
NEXT_PUBLIC_DOCS_ORIGIN=http://localhost:3001
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Hosted release: use hosted instead of the local access-key flow.
ACCESS_MODE=local
APP_ORIGIN=http://localhost:3000
ENGINE_SERVICE_TOKEN=
HOSTED_SESSION_HOURS=24
HOSTED_MAX_STREAMS=32
HOSTED_STREAMS_PER_SESSION=2
# Set finite base-unit budgets on the engine before enabling live execution.
HOSTED_FUNDING_BUDGET=
# Fee budgets are gas * maxFeePerGas units (18-decimal USD fee accounting).
HOSTED_FEE_BUDGET=
HOSTED_GAS_LIMIT=
HOSTED_MAX_FEE_PER_GAS=
HOSTED_MAX_TRANSACTIONS_PER_RUN=32
# Vercel only: public read-only access to published snapshots, independent of engine.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
